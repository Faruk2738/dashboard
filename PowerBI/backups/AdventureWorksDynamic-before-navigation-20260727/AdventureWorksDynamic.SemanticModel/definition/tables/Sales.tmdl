/// Sales data for the native interactive AdventureWorks report.
table Sales
	lineageTag: f20e43a5-757f-4914-b2ff-d1bef3bad162

	/// Business measure used by the AdventureWorks report.
	measure 'Total Sales' = SUM('Sales'[Sales Amount])
		formatString: $#,##0
		lineageTag: ccbfa4db-e561-4126-affd-3354c8f1993b

	/// Business measure used by the AdventureWorks report.
	measure 'Total Profit' = SUM('Sales'[Profit])
		formatString: $#,##0
		lineageTag: a82b732a-5177-4479-a2d7-16ca94794388

	/// Business measure used by the AdventureWorks report.
	measure 'Profit Margin' = DIVIDE([Total Profit], [Total Sales])
		formatString: 0.0%
		lineageTag: 59ebc5c8-a5ce-4fe9-b32b-f38a2e5c5e2f

	/// Business measure used by the AdventureWorks report.
	measure Orders = DISTINCTCOUNT('Sales'[Sales Order])
		formatString: #,##0
		lineageTag: 487da8f1-ed45-424b-9f6a-2a23ddca10a0

	/// Business measure used by the AdventureWorks report.
	measure 'Units Sold' = SUM('Sales'[Order Quantity])
		formatString: #,##0
		lineageTag: 22964f5e-8fa3-4fd7-8411-a643ab44f6ba

	/// Business measure used by the AdventureWorks report.
	measure 'Average Order Value' = DIVIDE([Total Sales], [Orders])
		formatString: $#,##0
		lineageTag: befd01ef-16be-420c-b68f-9094fe4fcc68

	/// Business measure used by the AdventureWorks report.
	measure 'Sales Forecast' = [Total Sales] * 1.035
		formatString: $#,##0
		lineageTag: b2ffc45a-09f7-4a08-897d-432737bd5cf4

	/// Business measure used by the AdventureWorks report.
	measure 'Total Product Cost' = SUM('Sales'[Product Cost])
		formatString: $#,##0
		lineageTag: c9be8fe0-6087-4e54-bf7f-36b20bdfecba

	/// Business measure used by the AdventureWorks report.
	measure 'Average Discount' = AVERAGE('Sales'[Discount Pct])
		formatString: 0.0
		lineageTag: 60cc57d7-fe59-44dc-8e2b-ed92223bc54a

	/// Business measure used by the AdventureWorks report.
	measure 'Active Customers' = DISTINCTCOUNT('Sales'[Customer Key])
		formatString: #,##0
		lineageTag: 97ef1d08-53f6-438c-b2c9-d97bbc4eb8bf

	/// Business measure used by the AdventureWorks report.
	measure 'Repeat Active Customers' = CALCULATE(DISTINCTCOUNT('Sales'[Customer Key]), KEEPFILTERS('Customer'[Frequency] > 1))
		formatString: #,##0
		lineageTag: 9081cf65-6d91-4046-aada-8d03f5860680

	/// Business measure used by the AdventureWorks report.
	measure 'New Active Customers' = CALCULATE(DISTINCTCOUNT('Sales'[Customer Key]), KEEPFILTERS('Customer'[Frequency] = 1))
		formatString: #,##0
		lineageTag: 703e2278-3e16-4a5d-b2f3-ee041030ea0d

	/// Sales Order Line imported from the prepared AdventureWorks dataset.
	column 'Sales Order Line'
		dataType: string
		lineageTag: 245942cf-4a0b-48ad-9069-bb75eb360b94
		summarizeBy: none
		sourceColumn: SalesOrderLine

	/// Sales Order imported from the prepared AdventureWorks dataset.
